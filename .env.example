# Dominio canónico cuando lo tengan (sin barra final).
# Ejemplos: https://www.hostelvalizas.com  |  https://hostelvalizas.com
VITE_SITE_URL=https://hostel-valizas.vercel.app

# Opcional: dominio registrado en Plausible (por defecto usa el hostname de VITE_SITE_URL)
# VITE_PLAUSIBLE_DOMAIN=www.hostelvalizas.com

# Admin (solo local / Vercel env, no commitear secretos)
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
