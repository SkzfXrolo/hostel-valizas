{
  "rewrites": [
    { "source": "/nosotros", "destination": "/nosotros.html" },
    { "source": "/habitaciones", "destination": "/habitaciones.html" },
    { "source": "/experiencias", "destination": "/experiencias.html" },
    { "source": "/tarifas", "destination": "/tarifas.html" },
    { "source": "/galeria", "destination": "/galeria.html" },
    { "source": "/resenas", "destination": "/resenas.html" },
    { "source": "/ubicacion", "destination": "/ubicacion.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/ficha", "destination": "/ficha.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "redirects": [
    { "source": "/nosotros.html", "destination": "/nosotros", "permanent": true },
    { "source": "/habitaciones.html", "destination": "/habitaciones", "permanent": true },
    { "source": "/experiencias.html", "destination": "/experiencias", "permanent": true },
    { "source": "/tarifas.html", "destination": "/tarifas", "permanent": true },
    { "source": "/galeria.html", "destination": "/galeria", "permanent": true },
    { "source": "/resenas.html", "destination": "/resenas", "permanent": true },
    { "source": "/ubicacion.html", "destination": "/ubicacion", "permanent": true },
    { "source": "/faq.html", "destination": "/faq", "permanent": true },
    { "source": "/ficha.html", "destination": "/ficha", "permanent": true },
    { "source": "/admin.html", "destination": "/admin", "permanent": true }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
